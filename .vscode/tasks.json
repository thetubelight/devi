{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Devi: configure (Release)",
      "type": "process",
      "command": "cmake",
      "args": ["-S", ".", "-B", "build", "-G", "Ninja", "-DCMAKE_BUILD_TYPE=Release"],
      "problemMatcher": []
    },
    {
      "label": "Devi: build (Release)",
      "type": "process",
      "command": "cmake",
      "args": ["--build", "build"],
      "dependsOn": "Devi: configure (Release)",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Devi: test (unit + perft + bench smoke)",
      "type": "process",
      "command": "ctest",
      "args": ["--test-dir", "build", "--output-on-failure"],
      "dependsOn": "Devi: build (Release)",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Devi: bench (depth 7)",
      "type": "process",
      "command": "${workspaceFolder}/build/devi.exe",
      "args": ["bench", "7"],
      "dependsOn": "Devi: build (Release)",
      "problemMatcher": []
    },
    {
      "label": "Devi: deep perft (depth 6-7, takes minutes)",
      "type": "process",
      "command": "${workspaceFolder}/build/perft_tests.exe",
      "args": ["--deep"],
      "dependsOn": "Devi: build (Release)",
      "problemMatcher": []
    },
    {
      "label": "Devi: configure (Debug)",
      "type": "process",
      "command": "cmake",
      "args": ["-S", ".", "-B", "build-debug", "-G", "Ninja", "-DCMAKE_BUILD_TYPE=Debug"],
      "problemMatcher": []
    },
    {
      "label": "Devi: build (Debug)",
      "type": "process",
      "command": "cmake",
      "args": ["--build", "build-debug"],
      "dependsOn": "Devi: configure (Debug)",
      "problemMatcher": ["$gcc"]
    }
  ]
}

{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Devi: debug engine (type UCI commands in the terminal)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build-debug/devi.exe",
      "args": [],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "externalConsole": false,
      "console": "integratedTerminal",
      "MIMode": "gdb",
      "preLaunchTask": "Devi: build (Debug)",
      "setupCommands": [
        { "description": "Enable pretty-printing for gdb", "text": "-enable-pretty-printing", "ignoreFailures": true }
      ]
    },
    {
      "name": "Devi: debug unit tests",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build-debug/unit_tests.exe",
      "args": [],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "externalConsole": false,
      "console": "integratedTerminal",
      "MIMode": "gdb",
      "preLaunchTask": "Devi: build (Debug)",
      "setupCommands": [
        { "description": "Enable pretty-printing for gdb", "text": "-enable-pretty-printing", "ignoreFailures": true }
      ]
    }
  ]
}
